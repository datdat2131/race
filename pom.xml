<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>me.astrax</groupId>
    <artifactId>AstraXRace</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>AstraXRace</name>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.helpch.at/releases/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- paper-api: bắt buộc (provided). PlaceholderAPI bên dưới là tùy chọn lúc chạy (softdepend). -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.4-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <!-- Tùy chọn (softdepend): placeholder %astraxrace_...% -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>AstraXRace-${project.version}</finalName>
        <!-- Flat layout: mọi file .java nằm ngay thư mục gốc -->
        <sourceDirectory>${project.basedir}</sourceDirectory>
        <resources>
            <resource>
                <directory>${project.basedir}</directory>
                <includes>
                    <include>plugin.yml</include>
                    <include>config.yml</include>
                    <include>races.yml</include>
                    <include>messages.yml</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                    <!-- Chỉ biên dịch đúng các file của bản hiện tại (bỏ qua file skill cũ còn sót) -->
                    <includes>
                        <include>AstraXRace.java</include>
                        <include>BuffDef.java</include>
                        <include>BuffManager.java</include>
                        <include>CommandManager.java</include>
                        <include>ConfigManager.java</include>
                        <include>CosmeticDef.java</include>
                        <include>CosmeticManager.java</include>
                        <include>EffectSpec.java</include>
                        <include>GUIManager.java</include>
                        <include>PlayerRaceData.java</include>
                        <include>Race.java</include>
                        <include>RaceGuiHolder.java</include>
                        <include>RaceListener.java</include>
                        <include>RaceManager.java</include>
                        <include>RacePlaceholders.java</include>
                        <include>RollManager.java</include>
                        <include>StorageManager.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
